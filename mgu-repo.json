{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID7"
    ],
    "requires": {
      "idrive7-renderd": "2.1.7",
      "mgu-inputgate": "1.0.0"
    },
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "network": [
        "doom"
      ],
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    },
    "exclude": [
      "aa_cluster_companion",
      "brake_test",
      "car_vitals",
      "doom",
      "draggy",
      "dtc_scanner",
      "dyno",
      "edrive",
      "gforce",
      "live_adjustments",
      "live_data",
      "redline",
      "service",
      "warmup",
      "zf8hp"
    ]
  }
}
